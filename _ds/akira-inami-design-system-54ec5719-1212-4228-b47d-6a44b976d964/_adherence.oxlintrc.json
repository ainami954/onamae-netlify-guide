{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/social/**",
              "ui_kits/instagram-posts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Gilda Display|Lexend|Young Serif))/i]",
        "message": "Font not provided by the design system. Available: Gilda Display, Lexend, Young Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Badge> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumeral'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|color|style|key|ref|className|style|children)$/]",
        "message": "<BigNumeral> doesn't accept that prop. Declared props: value, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|text|key|ref|className|style|children)$/]",
        "message": "<CheckListItem> doesn't accept that prop. Declared props: lead, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|tone|style|key|ref|className|style|children)$/]",
        "message": "<ComparisonTable> doesn't accept that prop. Declared props: columns, rows, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTable'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ComparisonTable> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|fullBleed|style|key|ref|className|style|children)$/]",
        "message": "<CTABar> doesn't accept that prop. Declared props: children, tone, fullBleed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<CTABar> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeviceFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|width|children|style|key|ref|className|style|children)$/]",
        "message": "<DeviceFrame> doesn't accept that prop. Declared props: kind, width, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeviceFrame'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:tablet|phone)$/]",
        "message": "<DeviceFrame> kind must be one of 'tablet' | 'phone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|align|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Eyebrow> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|align|color|as|style|key|ref|className|style|children)$/]",
        "message": "<Headline> doesn't accept that prop. Declared props: children, size, align, color, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Headline> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|div)$/]",
        "message": "<Headline> as must be one of 'h1' | 'h2' | 'h3' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconFeature'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|lead|children|align|style|key|ref|className|style|children)$/]",
        "message": "<IconFeature> doesn't accept that prop. Declared props: icon, lead, children, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconFeature'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<IconFeature> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|label|fade|style|key|ref|className|style|children)$/]",
        "message": "<PhotoSlot> doesn't accept that prop. Declared props: src, label, fade, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoSlot'] > JSXAttribute[name.name='fade'] > Literal[value!=/^(?:none|left|right)$/]",
        "message": "<PhotoSlot> fade must be one of 'none' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|motif|frame|size|children|style|key|ref|className|style|children)$/]",
        "message": "<PostCanvas> doesn't accept that prop. Declared props: tone, motif, frame, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCanvas'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<PostCanvas> tone must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
